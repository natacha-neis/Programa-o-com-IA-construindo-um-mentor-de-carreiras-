<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mentor de Carreiras IA</title>
  <style>
    /* Reset básico e variáveis de cores */
    :root {
      --bg-color: #0f172a;
      --chat-bg: #1e293b;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --msg-ai: #334155;
      --msg-user: #3b82f6;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    /* Container Principal */
    .mentor-container {
      width: 100%;
      max-width: 750px;
      background-color: var(--chat-bg);
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      height: 85vh;
    }

    /* Cabeçalho */
    .header {
      background-color: #020617;
      padding: 20px 24px;
      border-bottom: 1px solid #334155;
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .avatar {
      width: 48px;
      height: 48px;
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: bold;
      font-size: 1.2rem;
    }

    .header-info h1 {
      font-size: 1.2rem;
      font-weight: 600;
    }

    .header-info p {
      font-size: 0.85rem;
      color: #10b981;
    }

    /* Área de Mensagens */
    .chat-box {
      flex: 1;
      padding: 24px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .message {
      max-width: 80%;
      padding: 14px 18px;
      border-radius: 14px;
      line-height: 1.5;
      font-size: 0.95rem;
    }

    .message.ai {
      background-color: var(--msg-ai);
      align-self: flex-start;
      border-bottom-left-radius: 4px;
    }

    .message.user {
      background-color: var(--msg-user);
      align-self: flex-end;
      border-bottom-right-radius: 4px;
    }

    /* Sugestões Rápidas */
    .suggestions {
      padding: 12px 24px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      background-color: #172033;
      border-top: 1px solid #334155;
    }

    .chip {
      background-color: #334155;
      color: var(--text-main);
      border: 1px solid #475569;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    .chip:hover {
      background-color: var(--primary);
      border-color: var(--primary);
    }

    /* Área de Input */
    .input-area {
      padding: 16px 24px;
      background-color: #020617;
      display: flex;
      gap: 12px;
    }

    .input-area input {
      flex: 1;
      padding: 12px 16px;
      border-radius: 8px;
      border: 1px solid #334155;
      background-color: var(--chat-bg);
      color: var(--text-main);
      font-size: 0.95rem;
      outline: none;
    }

    .input-area input:focus {
      border-color: var(--primary);
    }

    .input-area button {
      background-color: var(--primary);
      color: white;
      border: none;
      padding: 0 24px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }

    .input-area button:hover {
      background-color: var(--primary-hover);
    }
  </style>
</head>
<body>

  <div class="mentor-container">
    <!-- Cabeçalho -->
    <div class="header">
      <div class="avatar">IA</div>
      <div class="header-info">
        <h1>Mentor de Carreiras Tech</h1>
        <p>● Online e pronto para ajudar</p>
      </div>
    </div>

    <!-- Histórico do Chat -->
    <div class="chat-box" id="chatBox">
      <div class="message ai">
        Olá! Sou seu Mentor de Carreiras com IA. Posso ajudar você a montar um plano de estudos, revisar seu currículo ou treinar para entrevistas. Por onde quer começar?
      </div>
    </div>

    <!-- Atalhos de Perguntas -->
    <div class="suggestions">
      <button class="chip" onclick="usarSugestao('Como migrar para a área de dados?')">Migrar para Dados</button>
      <button class="chip" onclick="usarSugestao('Dicas para melhorar meu LinkedIn')">Melhorar LinkedIn</button>
      <button class="chip" onclick="usarSugestao('Simular entrevista para Júnior')">Simular Entrevista</button>
    </div>

    <!-- Campo de Envio -->
    <div class="input-area">
      <input type="text" id="userInput" placeholder="Digite sua dúvida sobre carreira..." onkeypress="verificarEnter(event)">
      <button onclick="enviarMensagem()">Enviar</button>
    </div>
  </div>

  <!-- Script simples apenas para visualizar o funcionamento na tela -->
  <script>
    const chatBox = document.getElementById('chatBox');
    const userInput = document.getElementById('userInput');

    function adicionarMensagem(texto, remetente) {
      const div = document.createElement('div');
      div.classList.add('message', remetente);
      div.textContent = texto;
      chatBox.appendChild(div);
      chatBox.scrollTop = chatBox.scrollHeight;
    }

    function enviarMensagem() {
      const texto = userInput.value.trim();
      if (!texto) return;

      adicionarMensagem(texto, 'user');
      userInput.value = '';

      // Simulação de resposta (aqui entrará a chamada real da API de IA no futuro)
      setTimeout(() => {
        adicionarMensagem('Ótima pergunta! Para conectar uma IA real aqui, basta integrar este front-end com a API do Gemini ou OpenAI no seu back-end.', 'ai');
      }, 600);
    }

    function usarSugestao(texto) {
      userInput.value = texto;
      enviarMensagem();
    }

    function verificarEnter(event) {
      if (event.key === 'Enter') {
        enviarMensagem();
      }
    }
  </script>

</body>
</html>
